# Reddit OAuth — optional. Without it the radar uses Reddit's public JSON API.
REDDIT_CLIENT_ID=your_reddit_client_id
REDDIT_CLIENT_SECRET=your_reddit_client_secret
REDDIT_USER_AGENT=RedditIdeaRadar/2.0

# Anthropic API — optional. Not needed with --local (Claude Code CLI).
ANTHROPIC_API_KEY=your_anthropic_api_key

# Optional: POST every Tier 1 idea to this URL (Slack, Discord, n8n, ...).
WEBHOOK_URL=

# Dashboard / container settings (defaults shown).
HOST=127.0.0.1
PORT=8421
OUTPUT_DIR=
